--- a/test/checkout.test.mjs
+++ b/test/checkout.test.mjs
@@ -12,3 +12,9 @@ test("totals each item's price times its quantity", () => {
 test("an empty cart totals 0", () => {
   assert.equal(checkout([], user).total, 0);
 });
+
+test("reports the checkout to analytics", () => {
+  const events = [];
+  checkout([{ price: 500, qty: 1 }], user, { track: (name, data) => events.push({ name, data }) });
+  assert.deepEqual(events, [{ name: "checkout", data: { user: "u1", email: "ada@example.com", total: 500 } }]);
+});
