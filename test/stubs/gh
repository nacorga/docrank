#!/bin/sh
# GitHub as the case suites see it. `pr view <n> --json baseRefName` answers the
# base of four pull requests, one per kind the guard tells apart, and fails for
# any other, as gh does offline. `pr list` prints $GH_STUB_MERGED_HEADS, the head
# commits of merged pull requests, and nothing when it is unset.
case "$1 $2" in
  "pr view")
    case "$3" in
      1) echo main ;;
      2) echo develop ;;
      3) echo batch/demo-walk ;;
      4) echo feat/77-other-branch ;;
      *) exit 1 ;;
    esac ;;
  "pr list") [ -z "$GH_STUB_MERGED_HEADS" ] || printf '%s\n' $GH_STUB_MERGED_HEADS ;;
  *) exit 1 ;;
esac
