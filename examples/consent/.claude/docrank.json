{
  "gates": {
    "run": [{ "name": "test", "command": "node --test test/checkout.test.mjs" }]
  },
  "judges": {
    "routes": [{ "agent": "docrank:spec-arbiter", "ground": ["src/**"] }]
  },
  "docs": {
    "precedence": ["docs/spec.md"]
  },
  "docDrift": {
    "entries": [{ "code": ["src/"], "docs": ["docs/spec.md"] }]
  }
}
