# -- destructive git --------------------------------------------------------------
BLOCK|git reset --hard origin/main
BLOCK|git clean -fd
BLOCK|git clean -fdx
BLOCK|git checkout .
ALLOW|git reset HEAD~1
ALLOW|git checkout -- a.ts
ALLOW|git stash

# -- tags that match guard.blockedTagPatterns --------------------------------------
# `refs/tags/` and the bare name are tags only when they are one; --tags and
# --follow-tags carry tags the command does not name.
BLOCK|git push --tags
BLOCK|git push --follow-tags origin feat/07-channels
BLOCK|git push origin refs/tags/pkg-a@0.3.0
BLOCK|git push origin +refs/tags/pkg-a@1.0.0
ALLOW|git push origin refs/tags/other-1.0
ALLOW|git push origin feat/pkg-a@x
ALLOW|git tag pkg-a@0.3.0
ALLOW|git tag -l "pkg-a@*"
BLOCK|npm publish
BLOCK|pnpm publish
BLOCK|pnpm --filter @acme/pkg-a publish --access public
ALLOW|pnpm --filter @acme/pkg-a build
ALLOW|pnpm build
ALLOW|npm run publish-docs

# -- guard.extraDeny -----------------------------------------------------------------
BLOCK|docker volume rm app_pgdata
BLOCK|docker volume rm -f app_pgdata
BLOCK|cd infra && terraform destroy -auto-approve
ALLOW|docker volume rm other_data
ALLOW|terraform plan

