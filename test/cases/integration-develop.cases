ALLOW|rm -rf dist .cache
ALLOW|rm -f scratch.mjs

# -- the main checkout stays on the integration branch ------------------------------
# @develop runs from the sandbox repository itself, its main checkout.
BLOCK|@develop|git switch -c feat/x
BLOCK|@develop|git switch main
BLOCK|@develop|git switch -q main
BLOCK|@develop|git checkout -b feat/x origin/develop
BLOCK|@develop|git checkout main
BLOCK|@develop|gh pr checkout 12
BLOCK|@develop|git -C . switch -c feat/x
BLOCK|@develop|git fetch -q origin && git switch -c fix/y --no-track origin/develop
BLOCK|@develop|git switch -
BLOCK|@develop|git checkout -
BLOCK|@develop|git checkout -t origin/feat/x
BLOCK|@develop|git checkout --track origin/feat/x
BLOCK|@develop|git checkout -f main
BLOCK|@develop|git switch -c feat/x && git checkout -- seed.txt
BLOCK|@develop|git checkout -- seed.txt && git checkout main
ALLOW|@develop|git switch develop
ALLOW|@develop|git checkout develop
ALLOW|@develop|git checkout -- seed.txt
ALLOW|@develop|git checkout main -- seed.txt
ALLOW|@develop|git checkout seed.txt
ALLOW|@develop|git checkout -p main
ALLOW|@develop|git worktree add --no-track -b feat/x ../t origin/develop
# The same commands from a worktree are that worktree's business.
ALLOW|@wt:feat/wt|git switch -c feat/other
ALLOW|@wt:feat/wt|git checkout -b feat/other2
ALLOW|@wt:feat/wt|git checkout main
ALLOW|@wt:feat/wt|gh pr checkout 12

# -- deleting a branch: only once its pull request merged at its tip -----------------
# The sandbox has no GitHub to answer and no remote to read, so every forced delete
# blocks here; what is not a forced delete never asks. The merged case is in
# guard-bash.test.mjs.
BLOCK|git branch -D feat/x
BLOCK|git branch -Df feat/x
BLOCK|git branch --delete --force feat/x
BLOCK|git branch -d -f feat/x
BLOCK|git -C . branch -D feat/x feat/y
BLOCK|git fetch && git branch -D feat/x
BLOCK|git push origin --delete feat/x
BLOCK|git push origin -d feat/x
BLOCK|git push origin :feat/x
ALLOW|git branch -d feat/x
ALLOW|git branch -vv
ALLOW|git branch --show-current
ALLOW|git branch feat/new
ALLOW|git commit -m "never git branch -D feat/x before the merge"
ALLOW|git push origin feat/x
ALLOW|git push -u origin feat/x:feat/x
# A redirection is no branch, and the file after a bare `>` is none either. One
# that holds `&` or `|` is rewritten before the cut there, so the names after it
# still ask; glued to a name it leaves that name blocking.
ALLOW|git push origin --delete 2>&1
ALLOW|git push origin --delete > /tmp/push.log
ALLOW|git branch -D 2>/dev/null
ALLOW|git branch -D >> /tmp/branch.log
ALLOW|git branch -D 10>&2
ALLOW|git branch -D &>/dev/null
ALLOW|git branch -D >&/dev/null
ALLOW|git branch -D >| /tmp/branch.log
BLOCK|git push origin --delete feat/x 2>&1
BLOCK|git push origin --delete 2>&1 feat/x
BLOCK|git branch -D feat/x > /tmp/branch.log
BLOCK|git branch -D 2>&1 feat/x
BLOCK|git branch -D feat/a 2>&1 feat/b
BLOCK|git branch -D &>/dev/null feat/x
BLOCK|git branch -D >&/dev/null feat/x
BLOCK|git branch -D >| /tmp/branch.log feat/x
BLOCK|git branch -D feat/v2>&1
# A skipped word that goes on past its line hides the names on the next one.
BLOCK|git branch -D >\
BLOCK|git branch -D > \
BLOCK|git branch -D 2>"a feat/x
BLOCK|git branch -D 2>$(echo x
BLOCK|git push origin --delete >\
ALLOW|git branch --list > "a
# A skipped word is trusted only while it is plainly literal: anything that can
# carry it past a `;`, `&` or `|` hides what follows.
BLOCK|git branch -D >${x:-a;b} feat/x
BLOCK|git branch -D <(true;true) feat/x
BLOCK|git branch -D >'"'"a;b" feat/x
BLOCK|git branch -D >$'a\';b' feat/x
BLOCK|git branch -D >$(echo)/dev/null$(true;true) feat/x
BLOCK|git push origin -d <(true;true) feat/x
BLOCK|git push origin --delete >$'a\';b' feat/x
