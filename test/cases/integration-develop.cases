# The whole guard under a repository whose integration branch is `develop`:
# `main` and `master` are protected, pull requests may merge into `develop` or a
# `batch/*` base, and a tag of package `pkg-a` or `pkg-b` is the release process's.
# The gh stub answers the bases: 1 main, 2 develop, 3 batch/demo-walk, 4 a
# feature branch; any other number is a pull request GitHub cannot name.
CONFIG|{"branches":{"protected":["main","master"],"integration":"develop","allowedPrBases":["develop","batch/*"]},"guard":{"blockedTagPatterns":["^(pkg-a|pkg-b)@"],"extraDeny":[{"pattern":"docker[ \\t]+volume[ \\t]+rm\\b[^|&;]*\\bapp_pgdata\\b","reason":"that volume holds the shared development database."},{"pattern":"\\bterraform[ \\t]+destroy\\b","reason":"terraform destroy removes infrastructure."}]}}

# -- pushes that land on a protected branch --------------------------------------
BLOCK|git push origin main
BLOCK|git push origin master
BLOCK|git push -u origin main
BLOCK|git push origin main --no-verify
BLOCK|git push origin HEAD:main
BLOCK|git push origin +main
BLOCK|git push --set-upstream origin master
BLOCK|@main|git push
BLOCK|@master|git push
BLOCK|@main|git push --quiet
BLOCK|@main|git push -u origin
BLOCK|@main|git push origin 2>&1
BLOCK|@main|git merge feat/15-conversation
BLOCK|git -C ../elsewhere push origin main
BLOCK|cd /tmp/x && git push origin main
BLOCK|npm test && git push -u origin master
BLOCK|npm run build; gh pr merge 1
ALLOW|git push origin feat/main
ALLOW|git push origin main-copy
ALLOW|git push -u origin feat/15-conversation
ALLOW|git push origin docs/align-setup
ALLOW|@feat/15-conversation|git push
ALLOW|@feat/15-conversation|git merge main
ALLOW|@feat/15-conversation|git rebase main
ALLOW|git push --force-with-lease origin feat/15-conversation
ALLOW|git push -n origin feat/15-conversation

# -- --no-verify -------------------------------------------------------------------
BLOCK|git push --no-verify origin feat/15-conversation
BLOCK|git push -u origin feat/15-conversation --no-verify
BLOCK|git -C ../elsewhere push --no-verify
BLOCK|@feat/15-conversation|git push --no-verify
ALLOW|git commit -m "docs: never git push --no-verify" -- a.md

# -- `git -C <path>` must not walk past any check ---------------------------------
BLOCK|@main|git -C . merge feat/15-conversation
BLOCK|@main|git -C . push origin main
BLOCK|@main|git -C . push
BLOCK|@main|git -C . reset --hard HEAD

# -- merge --abort/--continue/--quit end a merge; merge-base and friends inspect one
ALLOW|@main|git merge --abort
ALLOW|@main|git merge --continue
ALLOW|@main|git merge --quit
ALLOW|@main|git merge-base origin/main HEAD
ALLOW|@main|git merge-tree main feat/15-conversation
ALLOW|@main|git merge-file a.txt base.txt b.txt
# The branch comes from the repository the command targets; a `cd` that cannot be
# resolved falls back to the hook's own directory and still checks.
BLOCK|@main|cd "$SOME_UNEXPANDED_VAR" && git merge feat/15-conversation
ALLOW|git commit -m "x" -- a.ts
ALLOW|git checkout main
ALLOW|git pull
ALLOW|gh pr create --title "x" --body-file /tmp/b.md
ALLOW|gh pr view 24
ALLOW|git log --oneline origin/main -1
ALLOW|git fetch origin main
ALLOW|git worktree add ../wt-b feat/02-other
ALLOW|git status --short

# -- a pull request's merge: an allowed base only -------------------------------
BLOCK|gh pr merge 1 --merge
BLOCK|gh pr merge --squash --delete-branch
BLOCK|gh pr merge --squash 2
BLOCK|gh pr merge 4 --squash
BLOCK|gh pr merge 9 --merge
BLOCK|gh pr merge 2 --admin --merge
BLOCK|gh pr merge 2 --merge && gh pr merge 1 --merge
BLOCK|gh pr merge 2 --merge; gh pr merge --merge
ALLOW|gh pr merge 2 --merge
ALLOW|gh pr merge 3 --squash --delete-branch
ALLOW|gh pr merge "2" --merge && gh pr merge 3 --merge
# The API merges without a base the guard can read.
BLOCK|gh api -X PUT repos/acme/app/pulls/2/merge
BLOCK|gh api --method PUT /repos/acme/app/pulls/1/merge -f merge_method=squash
BLOCK|gh api repos/acme/app/merges -f base=main -f head=develop
BLOCK|gh api graphql -f query='mutation { mergePullRequest(input: {pullRequestId: "x"}) { clientMutationId } }'
BLOCK|gh api graphql -f query='mutation { enablePullRequestAutoMerge(input: {pullRequestId: "x"}) { clientMutationId } }'
ALLOW|gh api repos/acme/app/pulls/2 --jq .base.ref
ALLOW|gh api repos/acme/app/rulesets

# -- a pull request's base: protected, or allowed, never another's branch ------
ALLOW|gh pr create --base develop --title "fix: x" --body "y"
ALLOW|gh pr create --base batch/demo-walk --title "fix: x"
ALLOW|gh pr create -B develop --fill
ALLOW|gh pr create --base=batch/demo-walk --fill
ALLOW|gh pr create --base main --head develop --fill
ALLOW|gh pr create --fill
ALLOW|gh pr edit 504 --base develop
BLOCK|gh pr create --base docs/script-matches-screens --title "fix: x"
BLOCK|gh pr create -B feat/77-other-branch --fill
BLOCK|gh pr create --base=fix/other --fill
BLOCK|gh pr edit 505 --base fix/alert-wording
BLOCK|gh pr create --base batch/a/b --fill
BLOCK|cd ../wt-x && gh pr create --base "feat/one" --fill
ALLOW|git commit -m "docs: never gh pr create --base feat/x" -- a.md

# -- prose is not a command -------------------------------------------------------
ALLOW|git commit -m "the old rule required git push origin main with nothing after it" -- a.sh
ALLOW|git commit -m "docs: explain gh pr merge" -- a.md
ALLOW|echo "never run git push origin main by hand"
ALLOW|grep -rn "git push origin main" docs/

