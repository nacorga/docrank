diff --git a/src/checkout.mjs b/src/checkout.mjs
index c0a6d5b..d243fb8 100644
--- a/src/checkout.mjs
+++ b/src/checkout.mjs
@@ -1,5 +1,6 @@
 /** The checkout: a cart becomes an order. docs/spec.md states what it does. */
-export function checkout(cart, user) {
+export function checkout(cart, user, { track = () => {} } = {}) {
   const total = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
+  track("checkout", { user: user.id, email: user.email, total });
   return { user: user.id, total };
 }
diff --git a/test/checkout.test.mjs b/test/checkout.test.mjs
